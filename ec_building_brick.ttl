    rdfs:comment "WebCTRL path /trees/geographic/#area1/#power_meters; dbid DBID:1:911445; template powermeter; class rule electric-meter (high)" ;
    brick:hasPoint bldg:area1_power_meters__cum_kwh_pius,
        bldg:area1_power_meters__cum_kwh_rtu2,
        bldg:area1_power_meters__current_pius,
        bldg:area1_power_meters__current_rtu2,
        bldg:area1_power_meters__pf_pius,
        bldg:area1_power_meters__pf_rtu2,
        bldg:area1_power_meters__power_demand_pius,
        bldg:area1_power_meters__power_demand_rtu2,
        bldg:area1_power_meters__power_pius,
        bldg:area1_power_meters__power_rtu2,
        bldg:area1_power_meters__va_pius,
        bldg:area1_power_meters__va_rtu2,
        bldg:area1_power_meters__voltage_pius,
        bldg:area1_power_meters__voltage_rtu2 ;
    brick:isPartOf bldg:area1 ;
    bsm:classConfidence "high" ;
    bsm:classRule "electric-meter" ;
    bsm:classRuleSource "override-pre" ;
    bsm:controller bldg:bacnet_device_260000 ;
    bsm:program "powermeter" ;
    bsm:runsProgram bldg:program_powermeter ;
    bsm:template "powermeter" ;
    bsm:webctrlDbid "DBID:1:911445" ;
    bsm:webctrlPath "/trees/geographic/#area1/#power_meters" .

