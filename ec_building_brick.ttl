    bsm:exportFolder "cloud_20261009_0300_full" ;
    bsm:location "dbbackup/trend inside the WebCTRL export" ;
    bsm:schema "SVWEB" ;
    bsm:seriesIndex "SVWEB.DATASOURCES (TID, SOURCE_PATH); samples are in SVWEB.DATASERIES_<tid> as aggregated protobuf blobs" .

