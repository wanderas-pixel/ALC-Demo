bldg:trend_database a bsm:TimeseriesDatabase ;
    rdfs:label "WebCTRL trend database" ;
    rdfs:comment "oldestSample and newestSample are local building time as listed in DATASOURCES; sample times in the blobs are UTC epoch milliseconds" ;
